{
  "name": "@software-combined/exact-mcp",
  "version": "1.0.0",
  "description": "SCG hosted personal-identity read-only Exact Online MCP, with a separate legacy stdio CLI.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:selects": "tsx scripts/validate-selects.ts",
    "smoke:list": "tsx scripts/smoke-list-tools.ts",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:loc": "node scripts/check-loc.mjs",
    "verify": "npm run check:architecture && npm run check:loc && npm run typecheck && npm test && npm run build && npm audit --omit=dev --audit-level=high"
  },
  "keywords": [
    "mcp",
    "exact-online",
    "exactonline",
    "accounting",
    "erp",
    "boekhouding",
    "model-context-protocol",
    "mcp-server",
    "ai",
    "claude",
    "claude-mcp",
    "anthropic",
    "exact-online-api",
    "kmo",
    "boostu"
  ],
  "author": "BoostU Agency <nick@boostu.be> (https://boostu.be)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/software-combined/SC_Exact_MCP.git"
  },
  "homepage": "https://github.com/software-combined/SC_Exact_MCP#readme",
  "bugs": {
    "url": "https://github.com/software-combined/SC_Exact_MCP/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "oidc-provider": "9.15.0",
    "@aws-sdk/client-dynamodb": "3.1169.0",
    "@aws-sdk/lib-dynamodb": "3.1169.0",
    "@aws-sdk/client-kms": "3.1169.0",
    "@aws-sdk/client-secrets-manager": "3.1169.0",
    "jose": "6.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/oidc-provider": "9.13.1",
    "yaml": "2.9.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  }
}
