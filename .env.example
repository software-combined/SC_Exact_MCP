# Hosted production settings. Secret values never belong in this file.
# Fill references from the approved production stack and private configuration.
SCG_ENVIRONMENT=production
AWS_REGION=eu-central-1
SCG_ORIGIN=https://exact-mcp.example.com
PORT=8080
SCG_STATE_TABLE=REPLACE_FROM_STACK
SCG_KMS_KEY_ARN=REPLACE_FROM_STACK
SCG_CONFIG_SECRET_ARN=REPLACE_FROM_STACK
SCG_EXACT_APP_ID=REPLACE_DEDICATED_MCP_APP_ID

# Operator must verify allowances and set explicit local safety budgets.
# No Exact quota is assumed. Empty values make startup fail.
SCG_APP_CALLS_PER_MINUTE=
SCG_DIVISION_CALLS_PER_MINUTE=
SCG_APP_CALLS_PER_DAY=
SCG_DIVISION_CALLS_PER_DAY=
